# PostgreSQL (Neon, Supabase, Vercel Postgres, etc.). Local example:
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sales_ai_agent?schema=public"
# Neon serverless (use the pooled `?sslmode=require` connection string they provide):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

OPENAI_API_KEY="YOUR_OPENAI_API_KEY_HERE"
# Secure token for automated inventory import endpoint (Power Automate / scheduler).
# Example: INVENTORY_AUTOMATION_TOKEN="change-me-long-random-secret"
# INVENTORY_AUTOMATION_TOKEN=""

# Password required by manual inventory import endpoint (/api/inventory/import).
# Enter this in the app's Admin prompt before importing.
# Example: INVENTORY_IMPORT_PASSWORD="change-me-admin-password"
# INVENTORY_IMPORT_PASSWORD=""

# Optional: absolute path to logo PNG (overrides public/company-logo.png)
# COMPANY_LOGO_PATH=""

# Outbound email (preliminary order copy to sales rep).
#
# --- Resend (good for Vercel / cloud; verify your domain in the Resend dashboard) ---
# Docs: https://resend.com/docs/send-with-nodemailer-smtp
# EMAIL_SMTP_HOST="smtp.resend.com"
# EMAIL_SMTP_PORT="465"
# EMAIL_SMTP_SECURE="true"
# EMAIL_SMTP_USER="resend"
# EMAIL_SMTP_PASS="re_xxxxxxxx"   # API key from Resend
# EMAIL_FROM="Everde Orders <orders@yourdomain.com>"   # domain must be verified in Resend
#
# --- Gmail (personal Google account; use an App Password, not your normal password) ---
# https://support.google.com/accounts/answer/185833
# EMAIL_SMTP_HOST="smtp.gmail.com"
# EMAIL_SMTP_PORT="587"
# EMAIL_SMTP_SECURE="false"
# EMAIL_SMTP_USER="you@gmail.com"
# EMAIL_SMTP_PASS="xxxx xxxx xxxx xxxx"   # 16-char App Password (spaces optional)
# EMAIL_FROM="Everde Preliminary <you@gmail.com>"   # From should match the Gmail account
#
# --- Microsoft 365 / Exchange Online (works from Vercel; no extra DNS if you already use M365 for the domain) ---
# IT must enable "Authenticated SMTP" (SMTP AUTH) for the mailbox you use.
# Use a dedicated service mailbox (e.g. preliminary-orders@everde.com), not a personal account if possible.
# If the account has MFA, you may need an app password or an OAuth-based flow (not configured in this app yet).
# EMAIL_SMTP_HOST="smtp.office365.com"
# EMAIL_SMTP_PORT="587"
# EMAIL_SMTP_SECURE="false"
# EMAIL_SMTP_USER="preliminary-orders@everde.com"
# EMAIL_SMTP_PASS="your-password-or-app-password"
# EMAIL_FROM="Everde Preliminary Orders <preliminary-orders@everde.com>"
# Optional: force STARTTLS (also auto-enabled for smtp.office365.com)
# EMAIL_SMTP_REQUIRE_TLS="true"
#
# --- Internal SMTP / Outlook relay (works on corp network only; not from Vercel to 10.x hosts) ---
# EMAIL_SMTP_HOST="10.182.1.25"
# EMAIL_SMTP_PORT="25"
# EMAIL_FROM="BINoReply@everde.com"
# EMAIL_SMTP_SECURE="false"
# Optional if your relay requires authentication:
# EMAIL_SMTP_USER=""
# EMAIL_SMTP_PASS=""
# TLS: by default, connecting to an IP (e.g. 10.182.1.25) skips cert hostname checks (Exchange certs
# rarely list the IP in SANs). Set EMAIL_SMTP_TLS_STRICT="true" to enforce full verification instead.
# Optional: EMAIL_SMTP_TLS_SERVERNAME="mail.yourdomain.com" — SNI name when the cert matches DNS only.
# Force insecure TLS: EMAIL_SMTP_TLS_REJECT_UNAUTHORIZED="false"
# Attach Preliminary Order Acknowledgement PDF to the sales-rep email (small; default on).
# EMAIL_ATTACH_PDF="false"

# ECE PPOI .dat (Oracle import): 8-char customer ref, 6-char operating unit (matches sample layout).
# ECE_CUSTOMER_REF="10011432"
# ECE_OPERATING_UNIT="HD VMI"

# Optional: attach a prefilled macro workbook copy for "Upload To Oracle".
# If omitted, only CSV is attached.
# ORACLE_ORDER_TEMPLATE_PATH="C:\\Users\\isunderland\\Desktop\\OrderTemplate.xlsm"
# ORACLE_TEMPLATE_ORDER_TYPE="SO CA STE IND/LANDSCAPE"
# ORACLE_TEMPLATE_ADDRESS_CATEGORY=""
# ORACLE_TEMPLATE_STORE_NUMBER="0000"
# ORACLE_ATTACH_TEMPLATE_EMAIL="false"         # keep false unless relay size allows .xlsm
# ORACLE_ATTACH_TEMPLATE_MAX_BYTES="2000000"   # safety cap for attached .xlsm
# ORACLE_TEMPLATE_PREFILL="false"               # false = send original template as-is; true = generate filled copy
